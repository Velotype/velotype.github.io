{
    "minimumDependencyAge": {"age": "P1D", "exclude": ["jsr:@velotype/*"]},
    "tasks": {
        "check": "deno run -A ./scripts/check-examples.ts",
        "run-examples": "deno run -A ./scripts/run-examples.ts",
        "smoke": "deno run -A ./scripts/smoke-examples.ts",
        "build": "deno run --allow-read --allow-write ./scripts/build-docs.ts && deno bundle ./src/main.tsx --output ./build/main.js --minify --platform browser && deno bundle ./src/playground.tsx --output ./build/playground.js --minify --platform browser && deno run --allow-read --allow-write ./scripts/build-pages.ts",
        "serve": "deno run --allow-read --allow-net jsr:@std/http@^1.0.20/file-server . --port 8000"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "@velotype/velotype",
        "lib": ["dom", "deno.ns", "esnext"]
    },
    "imports": {
        "@velotype/velotype": "jsr:@velotype/velotype@^0.3.3",
        "@velotype/velotype/jsx-runtime": "jsr:@velotype/velotype@^0.3.3",
        "@velotype/velodesign": "jsr:@velotype/velodesign@^0.4.1",
        "@velotype/velojson": "jsr:@velotype/velojson@^0.2.0",
        "marked": "npm:marked@15.0.12"
    },
    "lint": {"exclude": ["build/", "docs/", "content/examples/"], "rules": {"exclude": ["jsx-key"]}}
}
